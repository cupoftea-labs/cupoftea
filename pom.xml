<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cupoftea</groupId>
    <artifactId>cupoftea-parent</artifactId>
    <version>0.7.0</version>
    <packaging>pom</packaging>

    <name>CupOfTea Parent</name>
    <description>Lightweight modular library for data manipulation in Java.</description>
    <url>https://github.com/filippo-pequini/CupOfTea</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>filippo-pequini</id>
            <name>Filippo Pequini</name>
            <email>filippo_pequini@hotmail.com</email>
            <url>https://github.com/filippo-pequini</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/filippo-pequini/CupOfTea.git</connection>
        <developerConnection>scm:git:ssh://github.com:filippo-pequini/CupOfTea.git</developerConnection>
        <url>https://github.com/filippo-pequini/CupOfTea</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/filippo-pequini/CupOfTea/issues</url>
    </issueManagement>

    <modules>
        <module>cupoftea-core</module>
        <module>cupoftea-csv</module>
        <module>cupoftea-json</module>
        <module>cupoftea-excel</module>
        <module>cupoftea-parquet</module>
        <module>cupoftea-arrow</module>
        <module>cupoftea-html</module>
        <module>cupoftea-yaml</module>
        <module>cupoftea-xml</module>
        <module>cupoftea-all</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <cupoftea.version>0.7.0</cupoftea.version>
        <lombok.version>1.18.38</lombok.version>
        <annotations.version>26.0.2</annotations.version>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <assertj.version>3.27.7</assertj.version>
        <opencsv.version>5.10</opencsv.version>
        <jackson.version>2.18.11</jackson.version>
        <poi.version>6.0.0</poi.version>
        <xmlbeans.version>5.3.0</xmlbeans.version>
        <parquet.version>1.15.2</parquet.version>
        <hadoop.version>3.4.1</hadoop.version>
        <jsoup.version>1.23.2</jsoup.version>
        <snakeyaml.version>2.4</snakeyaml.version>
        <commons-io.version>2.18.0</commons-io.version>
        <commons-compress.version>1.27.1</commons-compress.version>
        <org.json.version>20250107</org.json.version>
        <arrow.version>18.2.0</arrow.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-core</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-csv</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-json</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-excel</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-parquet</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-arrow</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-html</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-yaml</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cupoftea</groupId>
                <artifactId>cupoftea-xml</artifactId>
                <version>${cupoftea.version}</version>
            </dependency>

            <!-- Annotations & Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${annotations.version}</version>
            </dependency>

            <!-- CSV -->
            <dependency>
                <groupId>com.opencsv</groupId>
                <artifactId>opencsv</artifactId>
                <version>${opencsv.version}</version>
            </dependency>

            <!-- JSON / Jackson -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${org.json.version}</version>
            </dependency>

            <!-- Excel (POI aligned to 5.5.1) -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.xmlbeans</groupId>
                <artifactId>xmlbeans</artifactId>
                <version>${xmlbeans.version}</version>
            </dependency>

            <!-- Commons Utilities -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>

            <!-- Parquet & Hadoop -->
            <dependency>
                <groupId>org.apache.parquet</groupId>
                <artifactId>parquet-avro</artifactId>
                <version>${parquet.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-common</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-mapreduce-client-core</artifactId>
                <version>${hadoop.version}</version>
            </dependency>

            <!-- Apache Arrow -->
            <dependency>
                <groupId>org.apache.arrow</groupId>
                <artifactId>arrow-vector</artifactId>
                <version>${arrow.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.arrow</groupId>
                <artifactId>arrow-memory-netty</artifactId>
                <version>${arrow.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-hdfs</artifactId>
                <version>${hadoop.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- HTML -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <!-- YAML -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                    <configuration>
                        <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <release>${maven.compiler.release}</release>
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
